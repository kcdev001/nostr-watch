{
  "name": "@nostr-watch/server",
  "version": "0.1.0",
  "private": true,
  "description": "Nostr Watch - Backend Server",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "start:bg": "nest build && nohup node dist/main > ../../logs/server.log 2>&1 & echo $! > ../../.server.pid && echo \"Server started (PID: $(cat ../../.server.pid)), log: logs/server.log\"",
    "stop": "kill $(cat ../../.server.pid) 2>/dev/null && rm -f ../../.server.pid && echo 'Server stopped' || echo 'Server not running'"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/config": "^3.3.0",
    "typeorm": "^0.3.20",
    "mysql2": "^3.11.0",
    "nostr-tools": "^2.10.0",
    "ws": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
